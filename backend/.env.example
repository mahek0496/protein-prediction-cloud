# Copy this file to backend/.env and edit. NEVER put AWS access keys in this file.
APP_ENV=local

# Frontend origins allowed by CORS (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- AWS ----------
AWS_REGION=us-east-1
# Leave empty for local-only development (files stored in backend/data/files)
S3_BUCKET_NAME=
S3_PREFIX=jobs
# auto = S3 when S3_BUCKET_NAME is set, else local | s3 | local
STORAGE_BACKEND=auto
PRESIGNED_URL_EXPIRY_SECONDS=900

# ---------- 3D structure prediction ----------
# esmatlas = ESMFold public API (no key) | nvidia = needs NVIDIA_API_KEY | none = disabled
PREDICTION_ENGINE=esmatlas
NVIDIA_API_KEY=
PREDICTION_TIMEOUT_SECONDS=120

# ---------- Workflow ----------
MIN_SEQUENCE_LENGTH=10
MAX_SEQUENCE_LENGTH=400
PARALLEL_WORKERS=6
MAX_CONCURRENT_JOBS=2
# ARTIFICIAL delay per analysis task (C-G) so parallelism is visible. 0 = off.
DEMO_TASK_DELAY_SECONDS=0
