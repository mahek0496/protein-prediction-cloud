# Copy to frontend/.env (local) or set before "npm run build" (deployment).
# URL of the FastAPI backend. This value is PUBLIC (bundled into the browser code):
# never put AWS keys or other secrets in any VITE_ variable.
#   Local:           VITE_API_BASE_URL=http://localhost:8000
#   EC2 direct:      VITE_API_BASE_URL=http://<EC2-PUBLIC-IP>:8000
#   EC2 with nginx:  VITE_API_BASE_URL=        (empty = same server as the website)
VITE_API_BASE_URL=http://localhost:8000
